> 
> # are the simulated values unbiased
> stk.fit <- stock.n(fit)
> stk.sim <- stock.n(fit2)
> stk.rat <- iterMedians(stk.sim)/stk.fit
> f.fit <- harvest(fit)
> f.sim <- harvest(fit2)
> f.rat <- iterMedians(f.sim)/f.fit
> cth.fit <- catch.n(fit)
> cth.sim <- catch.n(fit2)
> cth.rat <- iterMedians(cth.sim)/cth.fit
