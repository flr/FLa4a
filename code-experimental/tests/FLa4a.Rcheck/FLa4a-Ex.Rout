> 
> ### Name: a4aGr
> ### Title: Individual growth class
> ### Aliases: a4aGr a4aGr-class a4aGr-methods a4aGr,missing-method grMod
> ###   grMod-methods grMod,a4aGr-method grMod<- grMod<--methods
> ###   grMod<-,a4aGr,formula-method grInvMod grInvMod-methods
> ###   grInvMod,a4aGr-method grInvMod<- grInvMod<--methods
> ###   grInvMod<-,a4aGr,formula-method params,a4aGr-method
> ###   params<-,a4aGr,FLPar-method distr,a4aGr-method
> ###   distr<-,a4aGr,character-method vcov,a4aGr-method
> ###   vcov<-,a4aGr,numeric-method
> 
> ### ** Examples
> 
> mm <- matrix(NA, ncol=3, nrow=3)
> diag(mm) <- c(50, 0.001,0.001)
> mm[upper.tri(mm)] <- mm[lower.tri(mm)] <- c(0.1,0.01,0.00004)
> md <- ~linf*(1-exp(-k*(t-t0)))
> imd <- ~t0-1/k*log(1-len/linf)
> prs <- FLPar(linf=58.5, k=0.086, t0=0.001, units=c("cm","yr^-1","yr"))
> vbObj <- a4aGr(grMod=md, grInvMod=imd, params=prs, vcov=mm, distr="norm")
> 
> 
> 
> cleanEx()
> nameEx("a4aM-class")
