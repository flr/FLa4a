> 
> flush(stderr()); flush(stdout())
> 
> ### Name: a4aM
> ### Title: Natural mortality class
> ### Aliases: a4aM a4aM-class a4aM-methods a4aM,missing-method
> ###   show,a4aM-method shape shape-methods shape,a4aM-method shape<-
> ###   shape<--methods shape<-,a4aM-method level level-methods
> ###   level,a4aM-method level<- level<--methods level<-,a4aM-method trend
> ###   trend-methods trend,a4aM-method trend<- trend<--methods
> ###   trend<-,a4aM-method
> 
> ### ** Examples
> 
> mod1 <- FLModelSim(model=~exp(-age-0.5))
> mod2 <- FLModelSim(model=~1.5*k, params=FLPar(k=0.4))
> m1 <- a4aM(shape=mod1, level=mod2)
> 
